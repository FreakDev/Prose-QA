# PQA_LLM_MODEL=claude-sonnet-4-20250514
# PQA_LLM_PROVIDER=ollama
# PQA_LLM_MODEL=llama3.2

# Test credentials for auth scenarios (smoke server: scripts/smoke-hello-server.mjs)
PQA_TEST_EMAIL=demo@pqa.local
PQA_TEST_PASSWORD=demo-password
